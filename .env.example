# Optional override. With a configured key, Gemini is selected automatically.
# PETMIND_LLM_PROVIDER=gemini
PETMIND_RETRIEVAL_MODE=mcp
PETMIND_SEMANTIC_SEARCH=on
PETMIND_GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
PETMIND_ACTION_TIMEOUT_SECONDS=30
# Optional: Pi USB webcam preview through an SSH local forward.
# PETMIND_CAMERA_SNAPSHOT_URL=http://127.0.0.1:18081/snapshot.jpg
