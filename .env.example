# Roboflow API
# https://app.roboflow.com → 우측 상단 프로필 → API Keys
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Kaggle API
# https://www.kaggle.com → 프로필 → Settings → API → Create New Token
# 다운받은 kaggle.json 에서 복사
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key_here

# PetMind 통합 시연
PETMIND_DATABASE_URL=sqlite:///petmind.db
PETMIND_API_BASE=http://localhost:8000
PETMIND_EDGE_PROFILE=simulated
PETMIND_DEVICE_ID=petmind-dev-01
PETMIND_SIMULATE_ACTIONS=true
PETMIND_DEVICE_SIMULATE=true
PETMIND_MUSIC_PLAYER=simulated
# Raspberry Pi YouTube mode: set PETMIND_MUSIC_PLAYER=youtube and video IDs only.
PETMIND_MUSIC_COMMAND=mpv
PETMIND_YOUTUBE_CALM_PIANO_ID=
PETMIND_YOUTUBE_NATURE_SOUNDS_ID=
PETMIND_YOUTUBE_WHITE_NOISE_ID=
PETMIND_ALLOW_DIRECT_FEEDING=false
PETMIND_MAX_FEEDING_G=100
PETMIND_MAX_DAILY_FEEDING_G=300
PETMIND_FEEDING_COOLDOWN_MINUTES=120
PETMIND_ACTION_TIMEOUT_SECONDS=20
PETMIND_FEATURE_FEEDING=false
PETMIND_LLM_PROVIDER=rule
GEMINI_API_KEY=
PETMIND_GEMINI_MODEL=gemini-2.5-flash-lite
PETMIND_GEMINI_TIMEOUT_SECONDS=5
MQTT_BROKER=localhost
MQTT_PORT=1883
